[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "User-Agent",
      "x-goog-resumable",
      "x-upload-content-type",
      "x-upload-content-length",
      "X-Upload-Action",
      "X-Upload-Url"
    ],
    "maxAgeSeconds": 3600
  }
]
